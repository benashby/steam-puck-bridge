[Unit]
Description=Steam Controller Puck to virtual gamepad bridge
Documentation=https://github.com/benashby/steam-puck-bridge

[Service]
Type=simple
ExecStart=@BINDIR@/steam-puck-bridge
Restart=on-failure
RestartSec=2

# The daemon only needs /dev/hidraw* and /dev/uinput, and runs entirely
# unprivileged as the login user. On Bazzite/SteamOS those are already
# accessible (Valve's steam-devices rules + a uinput uaccess rule); on other
# distros see udev/60-steam-puck-bridge.rules in the repo.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
